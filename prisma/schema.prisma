generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum FormStatus {
  DRAFT
  SUBMITTED
}

enum PricingItemKind {
  BASE
  OPTIONAL
}

enum NotificationKind {
  REQUIREMENT_SUBMITTED
  PRICING_SUBMITTED
}

model User {
  id                    String              @id @default(cuid())
  email                 String              @unique
  passwordHash          String
  name                  String?
  role                  Role                @default(CUSTOMER)
  createdAt             DateTime            @default(now())
  requirement           Requirement?
  pricingQuote          PricingQuote?
  campaignLeads         CampaignLead[]
  /// The pricing form the admin prepared for this customer. Until it is set the
  /// customer only sees a "your pricing form is being prepared" message.
  pricingFormId         String?
  pricingForm           PricingForm?        @relation(fields: [pricingFormId], references: [id], onDelete: SetNull)
  pricingFormAssignedAt DateTime?
  notifications         AdminNotification[]
  /// Chosen at registration; decides which requirements form the customer fills.
  businessId            String?
  business              Business?           @relation(fields: [businessId], references: [id], onDelete: Restrict)

  @@index([pricingFormId])
  @@index([businessId])
}

/// A kind of business (e.g. digital goods / TV) with its own requirements form.
model Business {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  /// Customers can only pick active businesses when registering.
  active      Boolean  @default(true)
  sortOrder   Int      @default(0)
  /// JSON `RequirementForm` (steps → fields → options) edited in the admin panel.
  form        String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model Requirement {
  id           String     @id @default(cuid())
  userId       String     @unique
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status       FormStatus @default(DRAFT)
  currentStep  Int        @default(0)
  /// JSON `RequirementData`: answers keyed by field key plus "other" texts.
  data         String
  /// Copy of the business form at submission time, so later edits to the form
  /// never change how a submitted requirement is displayed.
  formSnapshot String?
  /// Denormalized from the fields with a contact / store / city role for lists.
  contactName  String?
  storeName    String?
  city         String?
  tvPrice      Int        @default(0)
  extrasPrice  Int        @default(0)
  totalPrice   Int        @default(0)
  submittedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model CampaignLead {
  id        String   @id @default(cuid())
  phone     String
  name      String?
  message   String?
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())
}

/// Sections with no `formId` make up the default template that new pricing
/// forms are copied from; every other section belongs to exactly one form.
model PricingSection {
  id        String        @id @default(cuid())
  formId    String?
  form      PricingForm?  @relation(fields: [formId], references: [id], onDelete: Cascade)
  title     String
  subtitle  String?
  sortOrder Int           @default(0)
  active    Boolean       @default(true)
  items     PricingItem[]
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([formId, sortOrder])
}

model PricingItem {
  id          String             @id @default(cuid())
  sectionId   String
  section     PricingSection     @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  title       String
  description String?
  price       Int                @default(0)
  imageUrl    String?
  kind        PricingItemKind    @default(OPTIONAL)
  /// Holds "BASE" (template) or "BASE:<formId>" on the single mandatory item of
  /// each form and NULL everywhere else. SQLite treats NULLs as distinct in a
  /// UNIQUE index, so this gives the "at most one base item per form" rule a
  /// database constraint instead of only code.
  baseLock    String?            @unique
  sortOrder   Int                @default(0)
  active      Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  quoteItems  PricingQuoteItem[]

  @@index([sectionId, sortOrder])
}

/// A full pricing form (its own sections and items) prepared by the admin and
/// assigned to one or more customers.
model PricingForm {
  id        String           @id @default(cuid())
  title     String
  note      String?
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  sections  PricingSection[]
  users     User[]
}

model AdminNotification {
  id        String           @id @default(cuid())
  kind      NotificationKind
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([readAt, createdAt])
}

model PricingQuote {
  id          String             @id @default(cuid())
  userId      String             @unique
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  basePrice   Int                @default(0)
  extrasPrice Int                @default(0)
  totalPrice  Int                @default(0)
  submittedAt DateTime           @default(now())
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  items       PricingQuoteItem[]
}

/// Snapshot of every item offered at submission time, so later edits to the
/// pricing configuration never rewrite an existing quote.
model PricingQuoteItem {
  id           String          @id @default(cuid())
  quoteId      String
  quote        PricingQuote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  itemId       String?
  item         PricingItem?    @relation(fields: [itemId], references: [id], onDelete: SetNull)
  sectionTitle String
  title        String
  description  String?
  price        Int
  kind         PricingItemKind
  /// Flat position of the row in the form as the customer saw it.
  position     Int
  selected     Boolean         @default(false)

  @@index([quoteId])
}
